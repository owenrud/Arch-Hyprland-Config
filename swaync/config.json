{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "none",
  "control-center-positionY": "none",
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 1,
  "control-center-margin-left": 0,
  "control-center-width": 400,
  "control-center-height": -1,
  "fit-to-screen": false,
  "layer-shell-cover-screen": true,

  "layer-shell": true,
  "layer": "overlay",
  "control-center-layer": "overlay",
  "cssPriority": "user",
  "notification-body-image-height": 100,
  "notification-body-image-width": 90,  
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-window-width": 350,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "menubar",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "title",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": false
    }, 
    "title": {
      "text": "Notifications Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }, 
    "mpris": {
      "image-size": 50,
      "image-radius":0
    },
    "volume" :{
	"label": "󰕾",
	"expand-button-label":"󰞖 ",
	"collapse-button-label":"󰞕 ",
	"show-per-app": true,
	"show-per-app-icon":true,
	"show-per-app-label":false
    },
    "menubar":{
	"menu#power":{
		"label":"󰐥",
		"position":"right",
		"actions":[
			{
			"label":"  Reboot",
			"command":"systemctl reboot"
			},
			{
			"label":"󰤂  Shut Down",
			"command":"systemctl poweroff"
			}
		]
	},
	"menu#profiles":{
		"label":"",
		"position":"right",
		"actions":[
			{
			"label":"Performance",
			"command": "powerprofilesctl set performance"
			},
			{
			"label": "Balanced",
			"command" : "powerprofilesctl set balanced"
			},
			{
			"label": "Power Saving",
			"command" :" powerprofilesctl set power-saver"
			}
		]
	},
	"menu#screenshot":{
		"label":"",
		"position":"left",
		"actions":[
			{
			"label":"󰍹  Entire screen",
			"command": "swaync-client -cp && sleep 1 && hyprshot -m output"
			},
			{
			"label":"  Select a Region",
			"command":"swaync-client-cp && sleep 1 && hyprshot -m region"
			}
		]
	}
    },
    "buttons-grid":{
	"actions":[
	{
	"label":" ",
	"command":"kitty --class= Gazelle -e gazelle"
	},
	{
	"label": "󰂯",
	"command":"blueman"
	},
	{
	"label": "",
	"command":"~/.config/rofi/keybind_cheatsheet.sh"
	},
	{
	"label":"",
	"command":"cliphist list | rofi -dmenu | cliphist decode | wl-copy"
	}
	]
    }
 }
}
