{
    "height":35,
    "margin-top": 4,
    "margin-left":8,
    "margin-right":8,
    "layer": "top",
    "modules-left": ["clock","mpris"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["wlr/taskbar","keyboard-state","group/hardware","group/utility","custom/notification"],   
    "battery": {
        "format": "{icon}",
        "tooltip-format" : "{capacity}% {time} {timeTo}",
        "format-icons": ["", "", "", "", ""],
        "max-length":25,
    },
    "clock": {
        "format": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "timezones" :["Singapore",
                    "Asia/Tokyo",    
                    ], 
        "calendar": {
                    "mode"          : "year",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#C49C40'><b>{}</b></span>",
                              "days":       "<span color='#B4D9EF'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#041A40'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "tz_up",
                    "on-scroll-down": "tz_down",
                    }
    },
   
    "pulseaudio": {
    "format": " {icon} {volume}%",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": ["", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol --class=pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
},
  
"mpris": {
	"format": "Playing: {player_icon} {dynamic}",
	"format-paused": "Paused : {status_icon} <i>{dynamic}</i>",
    "max-length":30,
    "dynamic-order":["title","artist"],
    "[format]-len": 3,
	"player-icons": {
		"default": "▶",
		"mpv": "🎵"
	},
	"status-icons": {
		"paused": "⏸"
	},
    "tooltip" : false
	// "ignored-players": ["firefox"]
},
"group/utility" :{
    "orientation" :"horizontal",
    "modules" :[	
        "network",
        "pulseaudio",
        "battery"
    ],
},
"network": {
    "icon-size":22,
    "interface": "enp0s3",
    "format": "{ifname}",
    "format-wifi": " {essid} ({signalStrength}%)" ,
    "format-ethernet": "󰌗 Connected",
    "format-disconnected": "󱚼 No Internet", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname}  ,Click to Open Network Manager",
    "tooltip-format-disconnected": "Disconnected",
    "on-click":"kitty --class=Gazelle -e gazelle",
    "max-length": 20
},

"wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Numix-Circle",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
       "tty-clock-float", "kitty","cava"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
        "Firefox Web Browser": "Firefox",
        "Foot Server": "Terminal"
    }
},

"memory": {
    "interval": 30,
    "format": "M {percentage}%"
},
   "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup>󱅫</sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

"cpu": {
    "interval": 10,
    "format": " {usage}% / ",
    "max-length": 10
},
"group/hardware":{
    "orientation" :"horizontal",
    "modules":[
        "cpu",
        "memory",
    ]
},
"keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
        "locked": "",
        "unlocked": ""
    }
},

"hyprland/workspaces": {
	"format": "",
       "persistent-workspaces": {
             "*": 5, // 5 workspaces by default on every monitor
             "HDMI-A-1": 3 // but only three on HDMI-A-1
       }
},

}
